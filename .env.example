# TelcoLearn Environment Configuration
# API Key for Google Gemini 3 Flash
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=45000
GEMINI_PER_ATTEMPT_TIMEOUT_MS=14000
GEMINI_THINKING_BUDGET=0

# Coolify PostgreSQL Database URL (db-telcolearn) untuk Dynamic Response Cache
# Kosongkan jika ingin fallback ke SQLite lokal (database/telcolearn.db)
DATABASE_URL=postgresql://postgres:password@db-telcolearn:5432/postgres

# WhatsApp Gateway & Pairing Configuration
# Set to 'true' to use 8-digit pairing code in CLI terminal, or 'false' to show QR code
USE_PAIRING_CODE=true
# Nomor WhatsApp bot dengan format kode negara tanpa simbol + (contoh: 6281234567890)
PHONE_NUMBER_FOR_PAIRING=6281234567890
BOT_PHONE_NUMBER=6281234567890

# Database path (default: database/telcolearn.db)
DATABASE_PATH=database/telcolearn.db

# Timezone for Cron Scheduler (WIB / GMT+7)
TIMEZONE=Asia/Jakarta

# Admin & Token Analytics Configuration
ADMIN_EMAIL=arya.nugroho.works1@gmail.com
ADMIN_PHONE_NUMBER=817090934764

# SMTP Configuration for Daily Email Reports (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=arya.nugroho.works1@gmail.com
SMTP_PASS=your_16_character_app_password
